PORT=8000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashlock
REDIS_URL=redis://localhost:6379
# Postgres pool size (original Django used persistent connections)
PG_POOL_MAX=20
# Token bucket: capacity, tokens added per refill, refill interval (seconds)
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_RATE=20
RATE_LIMIT_REFILL_INTERVAL=60
# Simulated work inside the naive / transactional endpoints (ms), as in the original
SIMULATED_DELAY_MS=500
